{
  "name": "scarcity-mindset-experiment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build",
